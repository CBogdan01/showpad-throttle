# Documentation template. npm start does not automatically load .env.
# To load a copied .env explicitly: node --env-file=.env dist/server.js
PORT=3000
HOST=127.0.0.1
RATE_LIMIT_STORE=memory
CLIENTS_FILE=./config/clients.example.json
RATE_LIMIT_NAMESPACE=local
LOG_LEVEL=info
# Required only in Redis mode:
REDIS_URL=redis://127.0.0.1:6379
